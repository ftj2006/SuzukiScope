<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- No system ActionBar: Compose's own TabRow/ConnectionBar are the real navigation/header,
         a second app-label bar on top of them just wastes vertical space (worst in landscape). -->
    <style name="Theme.SuzukiScope" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
